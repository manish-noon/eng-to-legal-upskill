# Copy to .env (gitignored) and fill in. tools/*.py load it automatically.
GOOGLE_API_KEY=your-gemini-api-key
# Script writer (generateContent). Untested alternatives on the same key: gemini-4-neon, gemini-4-argon
TEXT_MODEL=gemini-3.1-pro-preview
# Two-speaker TTS via the Interactions API
TTS_MODEL=gemini-3.8-flash-tts
